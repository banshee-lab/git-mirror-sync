# Cache directory
CACHE_DIR=/var/cache/forgejo-sync

# Forgejo Data Directory
FORGEJO_DATA_DIR=/var/lib/forgejo

# Forgejo Push SSH Key Path
FORGEJO_PUSH_SSH_KEY_PATH=/etc/forgejo-sync/ssh/id_rsa

# Forgejo URL Settings
FORGEJO_DOMAIN=git.example.com
FORGEJO_SSH_PORT=22

# Database Settings
FORGEJO_DB_HOST=postgres
FORGEJO_DB_PORT=5432
FORGEJO_DB_USER=forgejo
FORGEJO_DB_PASSWORD=forgejo_password
FORGEJO_DB_NAME=forgejo
FORGEJO_DB_SSLMODE=disable

# Webhook Settings
WEBHOOK_LISTEN_ADDR=:8080
WEBHOOK_GITHUB_SECRET=github_secret_example
WEBHOOK_GITLAB_SECRET=gitlab_secret_example

# History DB Path
HISTORY_DB_PATH=/var/cache/forgejo-sync/history.db

# Dashboard Settings
DASHBOARD_LISTEN_ADDR=:8081

# Worker Settings
WORKER_CONCURRENCY=4
GIT_COMMAND_TIMEOUT=10m

# Logging
LOG_LEVEL=info
